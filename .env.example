# Настройки приложения
APP_APP_NAME=taskmanager
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Логирование
APP_LOG_DIR=logs
APP_LOG_LEVEL=INFO
APP_LOG_FILE_NAME=taskmanager.log

# Безопасность и токены
APP_SECRET_KEY=generate_a_random_32_byte_secret_key_here
APP_ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_INVITE_TOKEN_EXPIRE_HOURS=48
APP_AUTH_COOKIE_SECURE=false

# Подключение к PostgreSQL
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=taskmanager
APP_DB_PASSWORD=taskmanager
APP_DB_NAME=taskmanager

# Пул соединений SQLAlchemy
APP_DB_POOL_SIZE=10
APP_DB_MAX_OVERFLOW=20
