# ==============================================================================
# Конфигурация бэкенда Taskmanager (FastAPI + PostgreSQL)
# Скопируйте этот файл в .env: cp .env.example .env
# Все параметры приложения считываются с префиксом APP_
# ==============================================================================

# ── Основные параметры приложения ─────────────────────────────────────────────
# Имя сервиса для OpenAPI и логов
APP_APP_NAME=taskmanager
# Режим отладки: true включает эхо SQL-запросов и документацию /docs, /redoc;
# в продакшене строго false в целях безопасности
APP_DEBUG=false
# Сетевой интерфейс и порт HTTP-сервера внутри контейнера
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Подключение к базе данных PostgreSQL ──────────────────────────────────────
# Хост и порт базы данных (в Docker Compose используйте имя сервиса: db)
APP_DB_HOST=db
APP_DB_PORT=5432
APP_DB_USER=taskmanager
APP_DB_PASSWORD=change_this_password_in_production!
APP_DB_NAME=taskmanager

# Прямая строка подключения (опционально, если задана — переопределяет параметры db_* выше):
# APP_DATABASE_URL=postgresql+asyncpg://taskmanager:password@db:5432/taskmanager

# Настройки пула соединений SQLAlchemy (asyncpg)
APP_DB_POOL_SIZE=10
APP_DB_MAX_OVERFLOW=20

# ── Аутентификация, токены и безопасность ──────────────────────────────────────
# Секретный криптографический ключ для подписи сессионных JWT-токенов (минимум 32 символа).
# Сгенерируйте в терминале: openssl rand -hex 32
APP_SECRET_KEY=generate_a_random_32_byte_secret_key_here_min32chars!

# Время жизни сессионного токена пользователя в минутах (1440 мин = 24 часа)
APP_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Время жизни одноразового инвайт-токена в часах (48 часов)
APP_INVITE_TOKEN_EXPIRE_HOURS=48

# Имя HttpOnly cookie для хранения токена сессии
APP_AUTH_COOKIE_NAME=tm_session

# Флаг Secure для cookie:
# - false: при работе по обычному HTTP (по IP-адресу без SSL)
# - true: ОБЯЗАТЕЛЬНО при работе через HTTPS / SSL-сертификат
APP_AUTH_COOKIE_SECURE=false

# Политика передачи cookie SameSite (lax, strict или none)
APP_AUTH_COOKIE_SAMESITE=lax

# Защита от брутфорса паролей:
# Максимальное число неудачных попыток входа до временной блокировки IP/логина
APP_BRUTE_FORCE_MAX_ATTEMPTS=5
# Окно отслеживания попыток в секундах (300 сек = 5 минут)
APP_BRUTE_FORCE_WINDOW_SECONDS=300
# Длительность блокировки после исчерпания попыток в секундах (900 сек = 15 минут)
APP_BRUTE_FORCE_LOCKOUT_SECONDS=900

# Список разрешенных CORS-ориджинов в формате JSON (при работе через общий Nginx не требуется)
APP_CORS_ORIGINS=["http://localhost:5001","http://127.0.0.1:5001","http://localhost:3000","http://127.0.0.1:3000"]

# ── Логирование ────────────────────────────────────────────────────────────────
# Директория для файлов логов
APP_LOG_DIR=logs
# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
APP_LOG_LEVEL=INFO
# Имя файла лога
APP_LOG_FILE_NAME=taskmanager.log
# Максимальный размер одного файла до ротации в байтах (10485760 = 10 МБ)
APP_LOG_MAX_BYTES=10485760
# Количество архивных файлов ротации
APP_LOG_BACKUP_COUNT=5

# ── Параметры для изолированного запуска docker-compose.yml в taskmanager ──────
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=change_this_password_in_production!
POSTGRES_DB=taskmanager
DB_PORT=127.0.0.1:5432
API_PORT=127.0.0.1:8000
